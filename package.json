{
  "name": "jev-presentation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/validate-fixtures.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "capture": "node scripts/capture.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-browser.mjs && node scripts/verify-intro.mjs && node scripts/verify-computation.mjs",
    "handout": "node scripts/export-handout.mjs"
  },
  "dependencies": {
    "katex": "0.19.0",
    "reveal.js": "6.0.2"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
